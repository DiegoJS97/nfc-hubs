<!doctype html>
<html lang="{{ businesses[slug].lang }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ businesses[slug].name }}</title>

    {#
      First-party stylesheets only. No externally hosted font, stylesheet, script, or
      tracker appears anywhere on this page (FR-022, D7) - the system font stack in
      base.css is what keeps that promise cheap.
    #}
    {#
      Every first-party path goes through `| url`, which prepends the Eleventy pathPrefix.
      GitHub Pages serves this repo as a PROJECT page under /<repo>/, so a bare "/_engine/..."
      would 404 in production while working perfectly on a root-served host - a page that
      renders unstyled only after deploy. The filter is the whole defence; scripts/lib/
      path-prefix.mjs is the single place the value lives.
    #}
    <link rel="stylesheet" href="{{ '/_engine/base.css' | url }}" />
    <link rel="stylesheet" href="{{ ('/businesses/' + slug + '/theme.css') | url }}" />
  </head>

  <body class="hub hub--{{ businesses[slug].register }}">
    <a class="skip-link" href="#entries">{{ site.ui.skipToContent }}</a>

    {% set business = businesses[slug] %}

    <main class="hub__main">
      <header class="hub__header">
        <h1 class="hub__name">{{ business.name }}</h1>
      </header>

      {#
        Array order IS the customer-facing priority order (SC-001). Nothing here sorts,
        filters, or reorders - the order is chosen per business in business.json, and what
        the data says is what the customer sees.

        The dispatch is on entry.type alone, so the archetype supports a CATALOG of entry
        types and each business instance picks the ones it wants. Adding a type is a new
        partial plus a branch here plus a case in resolve.js - never a per-business change.

        wifi and vcard come first because they render their own pending state internally:
        wifi is inert text either way (FR-007), and the vCard's all-or-nothing rule makes its
        pending branch a different button, not a different label.
      #}
      <ul class="entries" id="entries">
        {% for entry in business.entries %}
          {% set state = resolve.resolveEntry(entry, business) %}
          {% if entry.type == "wifi" %}
            {% include "partials/entry-wifi.njk" %}
          {% elif entry.type == "vcard" %}
            {% include "partials/entry-vcard.njk" %}
          {% elif state != "confirmed" %}
            {% include "partials/entry-pending.njk" %}
          {% elif entry.type == "maps" %}
            {% include "partials/entry-maps.njk" %}
          {% elif entry.type == "tel" %}
            {% include "partials/entry-tel.njk" %}
          {% else %}
            {% include "partials/entry-link.njk" %}
          {% endif %}
        {% endfor %}
      </ul>
    </main>

    {#
      Deferred so it never blocks the first render. The page is fully readable without it;
      its only job is showing the pending notice on tap (FR-024).
    #}
    <script src="{{ '/_engine/pending.js' | url }}" defer></script>

    {% if resolve.hasVcard(business) %}
      {# Only the hub that actually has a save-contact entry pays for this (FR-017, FR-022). #}
      <script src="{{ '/_engine/vcard.js' | url }}" defer></script>
    {% endif %}
  </body>
</html>
